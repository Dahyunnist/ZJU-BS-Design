UPLOAD_MAX_PER_MINUTE=20
APP_CACHE_ENABLED=true
APP_QUEUE_MAX_LENGTH=10000
ORPHAN_MIN_AGE=24h
APP_ORPHAN_SCAN_ENABLED=true
